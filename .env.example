# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=border-surveilance
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MQTT (Mosquitto) ─────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Python AI Runtime Service ────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Firebase Cloud Messaging ─────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── MinIO (Snapshot Storage) ─────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sih26187-snapshots

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=24h

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
